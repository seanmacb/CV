@article{yoachim2025lsstrubinscheduler,
 abstract = {v3. 12.0 Most of the updates in v3. 12.0 center around the ToO surveys and strategy. An important update is that if the ToO footprint contains only a single healpix, the tessellation to observe this ToO will be centered on the center of the healpix; corners of the healpix are also guaranteed to be covered. This is an improvement for well-localized ToOs, however more work remains to be done (so stay tuned for future updates). Other ToO configuration updates include removing duplicate detailers and fixing a potential bug in detailers due to not copying the list. The different neutrino ToO followup strategies were combined into a single survey. The new version of the ModelObservatory does not use rotSkyPos_desired (in order to better match the summit); this was implemented in an earlier update, however additional cleanup was done here to remove rotSkyPos_desired from the LongGapSurvey. The DDF data is updated …},
 author = {Peter Yoachim and Lynne Jones and Eric H Neilsen Jr and Sean MacBride and Keith Bechtol and Matthew R Becker},
 citation = {Zenodo, 2025},
 journal = {Zenodo},
 pub_year = {2025},
 title = {lsst/rubin_scheduler: v3. 12.0}
}


@article{andreoni2024rubin,
 abstract = {The Legacy Survey of Space and Time (LSST) at Vera C. Rubin Observatory is planned to begin in the Fall of 2025. The LSST survey cadence has been designed via a community-driven process regulated by the Survey Cadence Optimization Committee (SCOC), which recommended up to 3% of the observing time to carry out Target of Opportunity (ToO) observations. Experts from the scientific community, Rubin Observatory personnel, and members of the SCOC were brought together to deliver a recommendation for the implementation of the ToO program during a workshop held in March 2024. Four main science cases were identified: gravitational wave multi-messenger astronomy, high energy neutrinos, Galactic supernovae, and small potentially hazardous asteroids possible impactors. Additional science cases were identified and briefly addressed in the documents, including lensed or poorly localized gamma-ray bursts and twilight discoveries. Trigger prioritization, automated response, and detailed strategies were discussed for each science case. This document represents the outcome of the Rubin ToO 2024 workshop, with additional contributions from members of the Rubin Science Collaborations. The implementation of the selection criteria and strategies presented in this document has been endorsed in the SCOC Phase 3 Recommendations document (PSTN-056). Although the ToO program is still to be finalized, this document serves as a baseline plan for ToO observations with the Rubin Observatory.},
 author = {Igor Andreoni and Raffaella Margutti and John Banovetz and Sarah Greenstreet and Claire-Alice Hebert and Tim Lister and Antonella Palmese and Silvia Piranomonte and SJ Smartt and Graham P Smith and Robert Stein and Tomas Ahumada and Shreya Anand and Katie Auchettl and Michele T Bannister and Eric C Bellm and Joshua S Bloom and Bryce T Bolin and Clecio R Bom and Daniel Brethauer and Melissa J Brucker and David AH Buckley and Poonam Chandra and Ryan Chornock and Eric Christensen and Jeff Cooke and Alessandra Corsi and Michael W Coughlin and Bolivia Cuevas-Otahola and D'Ammando Filippo and Biwei Dai and S Dhawan and Alexei V Filippenko and Ryan J Foley and Anna Franckowiak and Andreja Gomboc and Benjamin P Gompertz and Leanne P Guy and Nandini Hazra and Christopher Hernandez and Griffin Hosseinzadeh and Maryam Hussaini and Dina Ibrahimzade and Luca Izzo and R Lynne Jones and Yijung Kang and Mansi M Kasliwal and Matthew Knight and Keerthi Kunnumkai and Gavin P Lamb and Natalie LeBaron and Cassandra Lejoly and Andrew J Levan and Sean MacBride and Franco Mallia and Alex I Malz and Adam A Miller and JC Mora and Gautham Narayan and Matt Nicholl and Tiffany Nichols and SR Oates and Akshay Panayada and Fabio Ragosta and Tiago Ribeiro and Dan Ryczanowski and Nikhil Sarin and Megan E Schwamb and Huei Sears and Darryl Z Seligman and Ritwik Sharma and Manisha Shrestha and Michael C Stroh and Giacomo Terreran and Aishwarya Linesh Thakur and Aum Trivedi and J Anthony Tyson and Yousuke Utsumi and Aprajita Verma and V Ashley Villar and Kathryn Volk and Meet J Vyas and Amanda R Wasserman and J Craig Wheeler and Peter Yoachim and Angela Zegarelli and Federica Bianco},
 citation = {arXiv preprint arXiv:2411.04793, 2024},
 journal = {arXiv preprint arXiv:2411.04793},
 pub_year = {2024},
 title = {Rubin ToO 2024: Envisioning the Vera C. Rubin Observatory LSST Target of Opportunity program}
}


@article{abac2026gwtc50,
 abstract = {Version 5.0 of the Gravitational-Wave Transient Catalog (GWTC-5.0) adds new candidates detected by the LIGO Virgo KAGRA network of observatories through the second part of the fourth observing run (O4b: 2024 April 10 15:00:00 to 2025 January 28 17:00:00 UTC) and four days of the preceding engineering run (2024 April 6 to 2024 April 10). We find 161 compact binary coalescence candidates that are identified by at least one of our search algorithms with a probability of astrophysical origin  and that are not vetoed during event validation. We also provide detailed source property measurements for 104 candidates that have a false-alarm rate < 1yr. Based on the inferred component masses, all these candidates are consistent with signals from binary black holes. Median inferred component masses in the new candidates range from 5.14 (GW241109_115924) to 70 (GW241116_151753). Improvements in detector sensitivity allow us to observe compact binary coalescences with increasing clarity: 5 binary-black-hole signals have network signal-to-noise ratio exceeding 30, with a maximum to date of 76.9 for GW250114_082203. Such loud signals enable more precise studies of properties of their astrophysical sources and tests of general relativity. We also present updated results up to the first part of the fourth observing run, identifying 229 candidates. This brings the total number of transients in the cumulative GWTC having  to 390, further expanding the size of the catalog and our view of the gravitational-wave universe.},
