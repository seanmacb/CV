@article{sherman2024ligovirgokagra,
 abstract = {We report initial results of our DECam search for an optical counterpart of S240413p (LVK, GCN 36075) using DECam. Starting at 2024-04-16 00: 33 UTC (~ 69.25 hr post merger), we observed approximately the entirety of the 90% localization region provided in the updated sky map released on April 13, 2024 20: 33: 39 UTC. Images were processed by our difference imaging pipeline (Herner et al. 2020) using DES and public DECam images as templates. We employ a machine learning code (autoscan, Goldstein et al. 2015) to reject subtraction artifacts. Candidates were initially selected by requiring at least two high signal to noise detections, which were separated in time in order to reject moving objects. We also require an autoscan score of at least 0.7 on at least one of those detections, and a host redshift consistent with the LVK reported distance within three sd We have identified three candidates coinciding …},
