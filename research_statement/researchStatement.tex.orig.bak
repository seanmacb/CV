% \statement{Future Research Activities} 
\begin{tcolorbox}[
  colback=blue!5!white,      % Interior background color
  colframe=blue!75!black,    % Outer border color
  title=Future Research Activities % Top box title
]
  \begin{itemize}[noitemsep, topsep=0pt, leftmargin=1.2em]
    \item Develop future astronomical instruments, focusing on a complement to \Rubin, and deploy monitoring tools for LSST-Camera.
    \item Lead Target-of-Opportunity searches using Vera C. Rubin Observatory to detect the next bright siren, and other exotic astrophysical events.
    \item Usher dark siren cosmology into a precision era using LSST data and specialized observational programs.
  \end{itemize}
\end{tcolorbox}
